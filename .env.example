# GrX Parfums Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=grx-parfums-insecure-dev-key-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://grx_user:grx_password@localhost:5432/grx_db
# In Docker Compose, the host is 'db':
# DATABASE_URL=postgres://grx_user:grx_password@db:5432/grx_db

POSTGRES_DB=grx_db
POSTGRES_USER=grx_user
POSTGRES_PASSWORD=grx_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Stripe Configuration (Test Mode)
STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
STRIPE_CURRENCY=ron

# Base URL for Stripe Redirects (Domain)
SITE_URL=http://localhost:8000
